# LUSOPAY Bot Manager - Windows Worker (variáveis de ambiente; ver docs/instalacao-windows.md)
# NÃO colocar valores reais neste ficheiro de exemplo.

WORKER_BACKEND_URL=https://botmanager.lusopay.local
# Ficheiro com o token do worker (ACL apenas para a conta dos bots). Preferir a WORKER_TOKEN.
WORKER_TOKEN_FILE=C:\LusopayWorker\secret\worker.token
# Certificado da CA interna, se o backend usar um certificado interno
# WORKER_CA_BUNDLE=C:\LusopayWorker\ca.pem

# Adaptadores autorizados neste worker (o administrador também os restringe no backend)
WORKER_ADAPTERS=taskt_cli

# taskt (confirmar caminhos no servidor; RootFolder em %APPDATA%\taskt\AppSettings.xml)
WORKER_TASKT_EXE=C:\Program Files (x86)\taskt\taskt.exe
WORKER_TASKT_SCRIPTS_DIR=C:\Users\<conta-bots>\Documents\taskt\My Scripts
WORKER_TASKT_LOGS_DIR=C:\Users\<conta-bots>\Documents\taskt\Logs

# OpenBots (adaptador ainda não validado)
# WORKER_OPENBOTS_PROJECTS_DIR=C:\Users\<conta-bots>\Documents\OpenBotsStudio\My Scripts

WORKER_STATE_FILE=C:\LusopayWorker\worker-state.json
WORKER_POLL_SECONDS=10
WORKER_HEARTBEAT_SECONDS=15
WORKER_KILL_GRACE_SECONDS=10
