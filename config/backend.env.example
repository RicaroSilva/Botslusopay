# LUSOPAY Bot Manager - backend (copiar para backend/.env e restringir permissões do ficheiro)
# NÃO colocar valores reais neste ficheiro de exemplo.

BM_ENVIRONMENT=production
BM_DATABASE_URL=postgresql+psycopg://botmanager:<password>@<host>:5432/botmanager
# python -c "import secrets; print(secrets.token_urlsafe(48))"
BM_SECRET_KEY=<gerar-pelo-menos-32-caracteres>
BM_COOKIE_SECURE=true
BM_SESSION_MINUTES=480
BM_TIMEZONE=Europe/Lisbon

# Registo de bots (por omissão: <repo>/bots/registry). Não incluir bots/registry-dev em produção.
# BM_REGISTRY_DIR=C:\LusopayBotManager\app\bots\registry
# BM_EXTRA_REGISTRY_DIRS=[]

# Quatro olhos: quem pede uma execução não a pode aprovar
BM_ALLOW_SELF_APPROVAL=false

# Hosts que as regras poll_http podem consultar (JSON). Credenciais em variáveis BM_POLL_<NOME>.
BM_POLL_ALLOWED_HOSTS=[]
# BM_POLL_STATUS_TOKEN=Bearer <token>

BM_WORKER_HEARTBEAT_TIMEOUT_SECONDS=180
BM_SCHEDULE_MISFIRE_GRACE_SECONDS=300
BM_LOGIN_MAX_FAILURES=5
BM_LOGIN_LOCKOUT_MINUTES=15
