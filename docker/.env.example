# Copiar para a raiz do repositório como .env e preencher. NUNCA commitar o .env.
#
# Gerar valores:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  → BM_SECRET_KEY, BM_RUNNER_TOKEN, POSTGRES_PASSWORD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     → BM_VAULT_KEY
# (ou dentro do Docker: docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))")

POSTGRES_PASSWORD=
BM_SECRET_KEY=
# Chave do cofre de credenciais. GUARDAR EM LOCAL SEGURO: sem ela as credenciais não podem ser decifradas.
BM_VAULT_KEY=
# Token partilhado entre a API e o runner de fluxos (mín. 32 caracteres)
BM_RUNNER_TOKEN=

# Primeiro administrador (só é criado se ainda não existirem utilizadores). Remover depois do primeiro arranque.
BM_BOOTSTRAP_ADMIN_USERNAME=admin
BM_BOOTSTRAP_ADMIN_PASSWORD=

# Porta publicada no anfitrião
BM_HTTP_PORT=8080
# false apenas para testes locais em http://; em produção, atrás de HTTPS, true
BM_COOKIE_SECURE=true
# Hosts que os fluxos podem chamar (JSON). Vazio = qualquer host.
BM_FLOW_ALLOWED_HOSTS=["dev.lusopay.com","app.lusopay.com"]

# PostgreSQL externo (opcional): descomente e remova o serviço db do docker-compose.yml
# BM_DATABASE_URL=postgresql+psycopg://utilizador:password@servidor:5432/botmanager
